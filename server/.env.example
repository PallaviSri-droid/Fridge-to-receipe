# FridgeChef AI — backend environment. Copy to server/.env and fill in.
# server/.env is git-ignored; never commit a real key.

# Provider: "gemini" (real) or "mock" (deterministic, no key needed).
# Leave this COMMENTED OUT to auto-select: gemini when a real GEMINI_API_KEY is set, else mock.
# Uncomment and set to "mock" only if you want to force the mock even with a key present.
# AI_PROVIDER=mock

# Your Gemini API key from https://aistudio.google.com/ (only needed for AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Model ID. Default is a Google rolling alias that is hot-swapped as models update.
# Override with any current stable ID, e.g. gemini-3.8-flash or gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-flash-latest

# Server port (frontend dev server proxies /api here).
PORT=3001

# Upstream timeout before returning 504 (ms).
REQUEST_TIMEOUT_MS=30000

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
