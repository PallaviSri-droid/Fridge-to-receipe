{
  "name": "fridgechef-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "FridgeChef AI — turn the ingredients you have into a structured, interactive recipe.",
  "scripts": {
    "start": "npm run dev:all",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:mock": "cross-env AI_PROVIDER=mock node server/index.js",
    "dev:all": "concurrently -n server,web -c blue,magenta \"npm run server\" \"npm run dev\"",
    "dev:mock": "concurrently -n server,web -c blue,magenta \"npm run server:mock\" \"npm run dev\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
